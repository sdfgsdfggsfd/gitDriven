# Who can approve PRs. With "Require review from Code Owners" enabled in the branch
# ruleset, no PR gets in without an OK from someone listed here.
# To add approvers, put their usernames next to the owner (e.g. @sdfgsdfggsfd @alice).

*                     @sdfgsdfggsfd

# Sensitive areas: the updater, the build and the automation run on the server machine,
# and server/ is copied over the server root.
/plugins/core/        @sdfgsdfggsfd
/server/              @sdfgsdfggsfd
# Gradle runs these as code on the server machine during every build: the root build and
# settings, every plugin's build.gradle.kts, buildSrc/ and the properties that tune Gradle.
*.gradle.kts          @sdfgsdfggsfd
*.gradle              @sdfgsdfggsfd
gradle.properties     @sdfgsdfggsfd
/buildSrc/            @sdfgsdfggsfd
/gradle/              @sdfgsdfggsfd
/gradlew              @sdfgsdfggsfd
/gradlew.bat          @sdfgsdfggsfd
/scripts/             @sdfgsdfggsfd
/.github/             @sdfgsdfggsfd
